# ============================================================
# Smart Resume Analyser — Environment Variables
# ============================================================

# Optional: OpenAI API key for LLM-based resume improvement suggestions.
# Leave blank or remove to disable LLM features. The app works fully without it.
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override default Hugging Face cache directory for models
# HF_HOME=/path/to/custom/cache
